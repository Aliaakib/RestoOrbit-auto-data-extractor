# ==============================================================================
# Auto-Data-Extractor Microservice Configuration
# ==============================================================================

# Service Info & Server
SERVICE_NAME=auto-data-extractor
SERVICE_VERSION=1.0.0
ENV=development
HOST=0.0.0.0
PORT=5010
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5005

# Security & Authentication
# Must match resto-orbit-backend JWT_SECRET for seamless user token verification
JWT_SECRET=change_me_to_match_resto_orbit_backend_jwt_secret
JWT_ALGORITHM=HS256
# Optional static service-to-service API key for internal/cron triggers (header: X-Service-Key)
INTERNAL_API_KEY=change_me_internal_service_key

# PostgreSQL (Shared RestoOrbit Database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resto-orbit-test
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=15
DB_CONNECT_TIMEOUT=5

# Core Backend Integration (Optional HTTP fallback / webhook)
RESTO_ORBIT_BACKEND_URL=http://localhost:5005/api/v1

# IMAP Email Inbox Configuration (Back-Office Report Ingestion)
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_SEARCH_CRITERIA=UNSEEN
IMAP_SENDER_FILTER=
IMAP_SUBJECT_FILTER=
IMAP_MARK_AS_READ=true
IMAP_MOVE_PROCESSED_FOLDER=

# Background Polling Scheduler
POLL_INTERVAL_SECONDS=120
POLL_MAX_MESSAGES_PER_RUN=25

# Extraction & Import Defaults
MAX_PDF_SIZE_MB=15
DEFAULT_SHIFT_TYPE=Shift 2
AUTO_IMPORT_ENABLED=true
OVERWRITE_SUBMITTED_SHIFTS=false
